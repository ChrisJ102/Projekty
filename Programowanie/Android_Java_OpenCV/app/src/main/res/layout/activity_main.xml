<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <org.opencv.android.JavaCameraView
        android:id="@+id/cameraView"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_gravity="top"
        android:layout_marginTop="50dp"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="0dp" />

    <RelativeLayout
        android:id="@+id/firstRelativeLayout"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_alignParentTop="true"
        android:layout_marginTop="180dp">

        <TextView
            android:id="@+id/blobCountTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="6dp"
            android:text="Ilość kropek: 0"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_toRightOf="@+id/blobCountTextView"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="6dp"
            android:text="Odleglość: 0"
            android:textSize="16sp" />




        <TextView
            android:id="@+id/startingDistance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/distance"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="6dp"
            android:text="Odleglość początkowa: 0.00"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/force"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/distance"
            android:layout_toRightOf="@+id/startingDistance"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="6dp"
            android:text="Siła: 0"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/deformation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/startingDistance"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="8dp"
            android:text="Odkształcenie: 0"
            android:textSize="15sp" />



        <TextView
            android:id="@+id/timeTextStatic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/deformation"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="15dp"
            android:text="Czas:"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/deformation"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="15dp"
            android:layout_toRightOf="@+id/timeTextStatic"
            android:text="0"
            android:textSize="15sp" />

        <Button
            android:id="@+id/start"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_below="@+id/deformation"
            android:layout_toRightOf="@+id/time"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="6dp"
            android:text="Start" />


        <Button
            android:id="@+id/stop"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_below="@+id/deformation"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="6dp"
            android:layout_toRightOf="@+id/start"
            android:text="Stop" />





        <EditText
            android:id="@+id/fileNameEditText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/start"
            android:layout_marginLeft="10dp"
            android:hint="Nazwa"
            android:inputType="text" />

        <Button
            android:id="@+id/save"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_below="@+id/start"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="6dp"
            android:layout_toRightOf="@+id/fileNameEditText"
            android:text="Zapisz" />

        <Button
            android:id="@+id/wykresB"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_below="@+id/start"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="6dp"
            android:layout_toRightOf="@+id/save"
            android:text="Wykres" />


    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/secondRelativeLayout"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_alignParentStart="true"
        android:layout_below="@id/firstRelativeLayout"
        android:layout_marginStart="0dp">

        <CheckBox
            android:id="@+id/checkBoxNeg"
            android:layout_width="100dp"
            android:layout_height="30dp"
            android:layout_gravity="top"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="5dp"
            android:text="Negatyw" />

        <CheckBox
            android:id="@+id/checkBoxSzar"
            android:layout_width="100dp"
            android:layout_height="30dp"
            android:layout_gravity="top"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="5dp"
            android:layout_toRightOf="@+id/checkBoxNeg"
            android:text="Szarość" />


        <TextView
            android:id="@+id/brightnessLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/checkBoxNeg"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:text="Jasność"
            android:textSize="15sp" />

        <Button
            android:id="@+id/decreasebrightness"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_below="@id/checkBoxNeg"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="2dp"
            android:layout_toRightOf="@id/brightnessLabel"
            android:text="-" />

        <TextView
            android:id="@+id/brightness"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/checkBoxNeg"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="10dp"
            android:layout_toRightOf="@+id/decreasebrightness"
            android:text="0"
            android:textSize="15sp" />


        <Button
            android:id="@+id/incrasebrightness"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_below="@id/checkBoxNeg"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="2dp"
            android:layout_toRightOf="@+id/brightness"
            android:text="+" />


        <TextView
            android:id="@+id/contrastLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/brightnessLabel"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="15dp"
            android:text="Kontrast"
            android:textSize="15sp" />

        <Button
            android:id="@+id/decreasecontrast"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_below="@+id/brightnessLabel"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="6dp"
            android:layout_toRightOf="@+id/contrastLabel"
            android:text="-" />

        <TextView
            android:id="@+id/contrast"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/brightnessLabel"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="15dp"
            android:layout_toRightOf="@+id/decreasecontrast"
            android:text="0"
            android:textSize="15sp" />


        <Button
            android:id="@+id/incrasecontrast"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_below="@+id/brightnessLabel"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="6dp"
            android:layout_toRightOf="@+id/contrast"
            android:text="+" />

        <TextView
            android:id="@+id/blobMinArea"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/checkBoxNeg"
            android:layout_toRightOf="@id/incrasebrightness"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:text="Blob min"
            android:textSize="15sp" />

        <Button
            android:id="@+id/decreaseblobMin"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_below="@id/checkBoxNeg"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="2dp"
            android:layout_toRightOf="@+id/blobMinArea"
            android:text="-" />

        <TextView
            android:id="@+id/Minarea"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/checkBoxNeg"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="10dp"
            android:layout_toRightOf="@+id/decreaseblobMin"
            android:text="0"
            android:textSize="15sp" />


        <Button
            android:id="@+id/incraseblobMin"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_below="@id/checkBoxNeg"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="2dp"
            android:layout_toRightOf="@+id/Minarea"
            android:text="+" />


        <TextView
            android:id="@+id/blobMaxArea"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/blobMinArea"
            android:layout_toRightOf="@+id/incrasecontrast"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="15dp"
            android:text="Blob max"
            android:textSize="15sp" />

        <Button
            android:id="@+id/decreaseblobMax"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_below="@+id/blobMinArea"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="6dp"
            android:layout_toRightOf="@+id/blobMaxArea"
            android:text="-" />

        <TextView
            android:id="@+id/Maxarea"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="15dp"
            android:layout_below="@+id/blobMinArea"
            android:layout_toRightOf="@+id/decreaseblobMax"
            android:text="0"
            android:textSize="15sp" />


        <Button
            android:id="@+id/incraseblobMax"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="6dp"
            android:layout_below="@+id/blobMinArea"
            android:layout_toRightOf="@+id/Maxarea"
            android:text="+" />


        <EditText
            android:id="@+id/editTextRoiWidth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/decreasecontrast"
            android:layout_marginLeft="8dp"
            android:hint="Width"
            android:inputType="number" />

        <EditText
            android:id="@+id/editTextRoiHeight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/decreasecontrast"
            android:layout_marginLeft="8dp"
            android:layout_toRightOf="@+id/editTextRoiWidth"
            android:hint="Height"
            android:inputType="number" />

        <Button
            android:id="@+id/buttonChangeRoi"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="5dp"
            android:layout_below="@+id/decreasecontrast"
            android:layout_toRightOf="@+id/editTextRoiHeight"
            android:text="Zmień" />


        <Button
            android:id="@+id/clean"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_below="@+id/decreasecontrast"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="6dp"
            android:layout_toRightOf="@+id/buttonChangeRoi"
            android:text="Wyczyść" />


    </RelativeLayout>

    <com.github.mikephil.charting.charts.LineChart
        android:id="@+id/lineChartView"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_below="@id/secondRelativeLayout" />


</RelativeLayout>

